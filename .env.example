# Local development only. Do not put production secrets in this file.
# Copy to .env and adjust. CI uses the same names with job-scoped values.

DATABASE_URL=postgresql://ashland:ashland@localhost:5432/ashland_calendar

# Bearer token for GET /v1/ashland-ky/events.
# This placeholder is for local/dev. Rotate it before any shared environment.
ASHLAND_KY_API_TOKEN=dev-ashland-ky-local-token

# Dummy local embed key. The iframe at /embed does not require it.
EMBED_KEY=dev-embed-local-dummy

# Optional second-tenant token used only by isolation tests / local fixtures.
# Leave unset in production.
PEER_TENANT_API_TOKEN=dev-peer-tenant-local-token

LOG_LEVEL=info
TZ=America/New_York
