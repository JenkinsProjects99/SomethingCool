{
  "name": "ashland-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Visit AKY Ashland tourist PWA v0 — Design 96, public nine fields plus image, never auto-publish.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "tsx scripts/import-seed.ts",
    "seed:reload": "tsx scripts/import-seed.ts --reload",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx scripts/import-seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
