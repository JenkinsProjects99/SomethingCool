generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  pin
  published
}

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tokens    ApiToken[]
  events    Event[]

  @@map("tenants")
}

model ApiToken {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([tenantId])
  @@map("api_tokens")
}

/// Public nine: id, title, startsAt, endsAt, timezone, venue, address, url, source
/// Additive public: image (nullable URL), category (stored, not inferred from source).
/// slug/summary/status stay internal.
model Event {
  id        String      @id
  tenantId  String      @map("tenant_id")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  startsAt  DateTime    @map("starts_at")
  endsAt    DateTime?   @map("ends_at")
  timezone  String      @default("America/New_York")
  venue     String
  address   String
  url       String
  source    String
  image     String?
  category  String      @default("community")
  summary   String      @default("")
  dateOnly  Boolean     @default(false) @map("date_only")
  status    EventStatus @default(draft)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, status, startsAt])
  @@map("events")
}
